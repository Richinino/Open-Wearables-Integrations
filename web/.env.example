# Key that signs the session cookie; at least 32 random characters. Changing it logs everyone out.
SESSION_SECRET=
# Base URL of `owi serve`, without /v1/days. Accounts require a reachable backend.
OWI_API_URL=
# Bearer token for `owi serve` (its OWI_SERVE_TOKEN).
OWI_API_TOKEN=
# Token that lets the web save entries from Samsung Health (owi's OWI_WRITE_TOKEN). Server only.
OWI_WRITE_TOKEN=
# Optional synthetic data helper, non-production only; never bypasses account authentication.
OWI_LOCAL_DEMO=0
