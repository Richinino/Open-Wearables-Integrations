# Password for the login page. Login is disabled while it is empty.
SITE_PASSWORD=
# Key that signs the session cookie; at least 32 random characters. Changing it logs everyone out.
SESSION_SECRET=
# Base URL of `owi serve`, without /v1/days. Leave empty locally to get demo data.
OWI_API_URL=
# Bearer token for `owi serve` (its OWI_SERVE_TOKEN).
OWI_API_TOKEN=
