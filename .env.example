# Open Wearables API (bez /api/v1 na konci)
OWI_API_URL=http://localhost:8000
# API key from the Open Wearables admin portal. Never commit the real value.
OWI_API_KEY=
# Optional: only needed when the instance has more than one user
OWI_USER_ID=
OWI_TIMEZONE=Europe/Bratislava
OWI_DATA_DIR=data
# Optional overrides; otherwise taken from the data
OWI_MAX_HR=
OWI_WEIGHT_KG=
OWI_VO2MAX=
OWI_BASAL_KCAL=
# Token for the read-only API (owi serve), at least 32 characters. Never commit the real value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OWI_SERVE_TOKEN=
